@model ASI.Basecode.Services.ServiceModels.AvailabilityCalendar.AvailabilityCalendarPageViewModel
@using ASI.Basecode.Services.Utilities
@using ASI.Basecode.Services.ServiceModels.AvailabilityCalendar
@{
    var selectedDate = string.IsNullOrWhiteSpace(Model.Filter.Date) ? ManilaClock.NowLocal.ToString("yyyy-MM-dd") : Model.Filter.Date;
    var dayView = Model.Filter.View == "timeGridDay";
}
@section Styles {
    <link rel="stylesheet" href="~/css/availability-week.css" asp-append-version="true" />
}
<section class="calendar-page" aria-label="Equipment availability">
    <p class="mb-5 text-sm text-gray-500">A shared view of reservations, active loans and current maintenance.</p>
    @if (!string.IsNullOrWhiteSpace(Model.ValidationMessage))
    {
        <div class="validation-summary-errors mb-4" role="alert">@Model.ValidationMessage</div>
    }
    <form id="availability-filters" method="get" asp-action="Index" class="calendar-search" role="search">
        <div class="calendar-search-field"><label class="sr-only" for="availability-search">Search equipment</label><input id="availability-search" type="search" name="Search" maxlength="100" value="@Model.Filter.Search" class="input" placeholder="Search item name or code" /></div>
        <div><label class="sr-only" for="availability-category">Category</label><select id="availability-category" name="CategoryId" class="input"><option value="">All categories</option>@foreach (var category in Model.Categories) { <option value="@category.CategoryId" selected="@(Model.Filter.CategoryId == category.CategoryId)">@category.CategoryName</option> }</select></div>
        <input id="availability-date" type="hidden" name="Date" value="@selectedDate" data-min="@AvailabilityCalendarFilterViewModel.MinDate" data-max="@AvailabilityCalendarFilterViewModel.MaxDate" />
        <input id="availability-view" type="hidden" name="View" value="@(dayView ? "timeGridDay" : "overview")" />
        <button class="btn-primary" type="submit">Search</button>
        <a asp-action="Index" class="btn-secondary">Clear</a>
    </form>
    <div class="surface calendar-surface">
        <div class="calendar-toolbar">
            <div class="calendar-view-buttons" aria-label="Calendar view"><button type="button" data-calendar-view="overview" aria-pressed="@((!dayView).ToString().ToLowerInvariant())">Week</button><button type="button" data-calendar-view="timeGridDay" aria-pressed="@(dayView.ToString().ToLowerInvariant())">Day</button></div>
            <div class="calendar-period"><button type="button" data-period-step="-1" class="calendar-arrow" aria-label="Previous period">‹</button><h2 id="calendar-period-label" class="font-display font-semibold" aria-live="polite"></h2><button type="button" data-period-step="1" class="calendar-arrow" aria-label="Next period">›</button><button type="button" data-period-step="0" class="calendar-today">Today</button></div>
            <div class="calendar-legend" aria-label="Status legend"><span><i class="legend-available"></i>Available</span><span><i class="legend-reserved"></i>Reserved</span><span><i class="legend-borrowed"></i>Borrowed</span><span><i class="legend-maintenance"></i>Maintenance</span><span><i class="legend-overdue"></i>Overdue</span></div>
        </div>
        <div id="availability-error" class="validation-summary-errors hidden" role="alert"></div>
        <p id="availability-loading" class="text-sm text-gray-500" role="status">Loading availability…</p>
        <button id="availability-retry" type="button" class="btn-secondary hidden">Retry</button>
        <div id="availability-calendar" class="calendar-scroll" tabindex="0" role="region" aria-label="Equipment schedule" data-events-url="@Url.Action("Events")" data-reservation-url="@Url.Action("Create", "Reservation")" data-can-reserve="@Model.CanCreateReservations" data-today="@ManilaClock.NowLocal.ToString("yyyy-MM-dd")">
            <div id="availability-overview" class="equipment-calendar"></div>
        </div>
        <p class="mt-5 text-sm text-gray-500">Blocks show approved reservations and active loans. Maintenance shows current condition; no completion date is recorded. Dates use Philippine time.</p>
        @if (Model.CanCreateReservations) { <p class="mt-2 text-sm text-gray-500">Select an available future day to request the item. Final availability is checked when you submit.</p> }
        <p class="mt-2 text-sm font-semibold text-primary-strong">Today: @ManilaClock.NowLocal.ToString("dddd d MMMM yyyy")</p>
    </div>
</section>
@section Scripts {
    <script src="~/js/availability-calendar.js" asp-append-version="true"></script>
}
