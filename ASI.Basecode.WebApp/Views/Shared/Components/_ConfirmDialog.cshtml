@model ASI.Basecode.WebApp.Models.ConfirmDialogModel
<dialog id="@Model.Id" aria-labelledby="@(Model.Id)-title" aria-describedby="@(Model.Id)-message"
        class="confirm-dialog border border-gray-200 bg-white p-0 text-left text-ink shadow-xl">
    <div class="p-5 sm:p-6">
        <h2 id="@(Model.Id)-title" class="font-display text-xl font-semibold text-ink">@Model.Title</h2>
        <p id="@(Model.Id)-message" class="mt-2 text-sm leading-6 text-gray-700">@Model.Message</p>
        @if (!string.IsNullOrWhiteSpace(Model.Detail))
        {
            <p data-confirm-detail class="mt-3 whitespace-pre-line break-words bg-gray-50 px-3 py-2 text-sm font-medium text-gray-700">@Model.Detail</p>
        }
        <div class="mt-6 flex flex-wrap justify-end gap-3">
            <button type="button" data-confirm-dismiss autofocus class="btn-secondary">@Model.CancelText</button>
            <button type="button" data-confirm-accept class="@(Model.IsDestructive ? "btn-danger" : "btn-primary") disabled:cursor-wait disabled:opacity-60">@Model.ConfirmText</button>
        </div>
    </div>
</dialog>
