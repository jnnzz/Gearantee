@model ASI.Basecode.WebApp.Models.Dashboard.KpiTileModel
<article class="summary-card min-w-0">
    <div class="flex items-start justify-between gap-3">
        <p class="eyebrow">@Model.Label</p>
        <partial name="Components/_StatusBadge" model="Model.Status" />
    </div>
    <p class="mt-2 font-display text-4xl font-semibold tabular-nums text-ink">@Model.Value</p>
    <p class="mt-1 min-h-5 text-xs leading-5 text-gray-500">@Model.Caption</p>
</article>
