@model string
@{
    var status = string.IsNullOrWhiteSpace(Model) ? "Unknown" : Model;
    var key = status.Replace(" ", "").Replace("-", "").ToLowerInvariant();
    var family = key switch
    {
        "available" or "active" or "eligible" or "returned" or "good" => "success",
        "approved" or "awaitingrelease" or "reserved" or "borrowed" => "info",
        "pending" or "duetoday" or "needsinspection" or "undermaintenance" or "underrepair" => "warning",
        "overdue" or "rejected" or "damaged" or "ineligible" => "danger",
        _ => "neutral"
    };
}
<span class="status-badge status-@family">@status</span>
