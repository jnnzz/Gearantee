@model PaginationViewModel
@{
    var previousNumber = 0;
}
<nav class="pagination" aria-label="@Model.Label">
    <div class="pagination-summary">
        <p>
            @if (Model.TotalCount == 0)
            {
                <span>No records to display</span>
            }
            else
            {
                <span>Showing <strong>@Model.FirstRecord–@Model.LastRecord</strong> of <strong>@Model.TotalCount</strong></span>
            }
        </p>
        <span class="pagination-limit">@Model.PageSize per page</span>
    </div>
    <div class="pagination-controls">
        <span class="pagination-position">Page @Model.CurrentPage of @Model.PageCount</span>
        @if (Model.CurrentPage > 1)
        {
            <a asp-action="Index" asp-all-route-data="@Model.RoutesFor(Model.CurrentPage - 1)" class="pagination-button" rel="prev">Previous</a>
        }
        else
        {
            <span class="pagination-button pagination-disabled" aria-disabled="true">Previous</span>
        }
        <div class="pagination-pages">
            @foreach (var pageNumber in Model.VisiblePages)
            {
                if (previousNumber > 0 && pageNumber - previousNumber > 1)
                {
                    <span class="pagination-ellipsis" aria-hidden="true">…</span>
                }
                if (pageNumber == Model.CurrentPage)
                {
                    <span class="pagination-button pagination-current" aria-current="page" aria-label="Page @pageNumber">@pageNumber</span>
                }
                else
                {
                    <a asp-action="Index" asp-all-route-data="@Model.RoutesFor(pageNumber)" class="pagination-button" aria-label="Page @pageNumber">@pageNumber</a>
                }
                previousNumber = pageNumber;
            }
        </div>
        @if (Model.CurrentPage < Model.PageCount)
        {
            <a asp-action="Index" asp-all-route-data="@Model.RoutesFor(Model.CurrentPage + 1)" class="pagination-button" rel="next">Next</a>
        }
        else
        {
            <span class="pagination-button pagination-disabled" aria-disabled="true">Next</span>
        }
    </div>
</nav>
