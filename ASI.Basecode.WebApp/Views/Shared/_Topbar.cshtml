@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    var hideDate = controller == "Dashboard" && action == "Borrower";
    var title = controller == "Reservation" && action == "Index" ? "My borrowing history" : ViewData["Title"];
}
<header class="workspace-topbar">
    <div class="flex items-center justify-between gap-4">
        <div class="flex min-w-0 items-start gap-3">
            <button id="sidebar-toggle" type="button" class="nav-toggle mt-1 inline-flex size-10 shrink-0 items-center justify-center border border-gray-200 text-gray-700 lg:hidden" aria-label="Open navigation" aria-controls="app-sidebar" aria-expanded="false">
                <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
            </button>
            <div class="min-w-0">
                <p class="eyebrow">@ViewData["Eyebrow"]</p>
                <h1 class="workspace-title">@title</h1>
            </div>
        </div>
        <div class="topbar-tools">
            @if (!hideDate)
            {
                <p class="header-date whitespace-nowrap text-xs text-gray-500">@ViewData["PageDate"]</p>
            }
            <partial name="_ThemePicker" />
        </div>
    </div>
</header>
