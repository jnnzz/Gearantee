@using ASI.Basecode.Data.Models
@using Microsoft.Extensions.Hosting
@inject IHostEnvironment HostEnvironment
@{
    var isAdmin = User.IsInRole(DomainValues.Roles.Administrator);
    var isCustodian = User.IsInRole(DomainValues.Roles.Custodian);
    var isBorrower = User.IsInRole(DomainValues.Roles.Borrower);
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var workspace = currentAction switch
    {
        "Borrower" => "Borrower workspace",
        "Custodian" => "Custodian workspace",
        "Administrator" => "Administrator workspace",
        _ => isAdmin ? "Administrator workspace" : isCustodian ? "Custodian workspace" : "Borrower workspace"
    };
    var roleTitle = isAdmin ? "System administrator" : isCustodian ? "Equipment custodian" : "Borrower";
    var displayName = User.FindFirst("display_name")?.Value ?? User.Identity?.Name ?? "Account";
    var initials = string.Concat(displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();
    var schoolId = User.FindFirst("school_id")?.Value;
    var department = User.FindFirst("department")?.Value;
}
<aside id="app-sidebar" class="fixed inset-y-0 left-0 z-40 flex w-64 -translate-x-full flex-col bg-gray-100 px-5 py-6 transition-transform duration-200 lg:static lg:translate-x-0" aria-label="Main navigation">
    <a asp-controller="Dashboard" asp-action="Index" class="mb-8 inline-flex items-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary" aria-label="Gearantee dashboard">
        <img src="~/img/gearantee-logo.png" alt="Gearantee — Campus equipment borrowing and reservation system" class="h-auto w-48" />
    </a>

    <div class="mb-8">
        <p class="eyebrow mb-3">Signed in as</p>
        <div class="flex min-w-0 items-center gap-3">
            <span class="flex size-10 shrink-0 items-center justify-center bg-tint font-display text-sm font-semibold text-primary-strong" aria-hidden="true">@initials</span>
            <div class="min-w-0">
                <p class="truncate text-sm font-semibold text-ink">@displayName</p>
                <p class="truncate text-xs text-gray-500">
                    @if (isBorrower && !string.IsNullOrWhiteSpace(schoolId))
                    {
                        @schoolId
                        @if (!string.IsNullOrWhiteSpace(department)) { <text> · @department</text> }
                    }
                    else
                    {
                        @roleTitle
                    }
                </p>
            </div>
        </div>
    </div>

    <p class="eyebrow mb-3">@workspace</p>
    <nav class="flex-1 space-y-1" aria-label="Workspace">
        <a asp-controller="Dashboard" asp-action="Index" class="nav-item @(currentController == "Dashboard" ? "nav-item-active" : "")">
            @await Html.PartialAsync("Icons/_Icon", "dashboard")<span>Dashboard</span>
        </a>

        @if (User.HasClaim("permission", DomainValues.Permissions.EquipmentBrowse))
        {
            <a asp-controller="Catalog" asp-action="Index" class="nav-item @(currentController == "Catalog" ? "nav-item-active" : "")" aria-current="@(currentController == "Catalog" ? "page" : null)">@await Html.PartialAsync("Icons/_Icon", "equipment")<span>Equipment catalog</span></a>
        }
        @if (isBorrower && User.HasClaim("permission", DomainValues.Permissions.ReservationCreate))
        {
            <a asp-controller="Catalog" asp-action="Index" class="nav-item @(currentController == "Reservation" && currentAction == "Create" ? "nav-item-active" : "")" aria-current="@(currentController == "Reservation" && currentAction == "Create" ? "page" : null)">@await Html.PartialAsync("Icons/_Icon", "calendar")<span>New reservation</span></a>
        }
        @if (isBorrower)
        {
            <a asp-controller="Reservation" asp-action="Index" class="nav-item @(currentController == "Reservation" && currentAction != "Create" ? "nav-item-active" : "")" aria-current="@(currentController == "Reservation" && currentAction != "Create" ? "page" : null)">@await Html.PartialAsync("Icons/_Icon", "review")<span>My reservations</span></a>
        }
        @if (User.HasClaim("permission", DomainValues.Permissions.EquipmentBrowse))
        {
            <a asp-controller="AvailabilityCalendar" asp-action="Index" class="nav-item @(currentController == "AvailabilityCalendar" ? "nav-item-active" : "")" aria-current="@(currentController == "AvailabilityCalendar" ? "page" : null)">@await Html.PartialAsync("Icons/_Icon", "calendar")<span>Availability calendar</span></a>
        }
        @if (isCustodian && User.HasClaim("permission", DomainValues.Permissions.ReservationReview))
        {
            <a asp-controller="ReservationReview" asp-action="Index" class="nav-item @(currentController == "ReservationReview" ? "nav-item-active" : "")" aria-current="@(currentController == "ReservationReview" ? "page" : null)">@await Html.PartialAsync("Icons/_Icon", "review")<span>Approval &amp; release</span></a>
        }
        @if ((isCustodian || isAdmin) && User.HasClaim("permission", DomainValues.Permissions.TransactionReleaseReturn))
        {
            <a asp-controller="ReturnRecord" asp-action="Index" class="nav-item @(currentController == "ReturnRecord" ? "nav-item-active" : "")" aria-current="@(currentController == "ReturnRecord" ? "page" : null)">@await Html.PartialAsync("Icons/_Icon", "return")<span>Return &amp; condition</span></a>
        }
        @if (isAdmin && User.HasClaim("permission", DomainValues.Permissions.EquipmentManage))
        {
            <a asp-controller="Categories" asp-action="Index" class="nav-item @(currentController == "Categories" ? "nav-item-active" : "")" aria-current="@(currentController == "Categories" ? "page" : null)">
                @await Html.PartialAsync("Icons/_Icon", "equipment")<span>Equipments &amp; categories</span>
            </a>
        }
        @if (isAdmin && User.HasClaim("permission", DomainValues.Permissions.BorrowerManage))
        {
            <a asp-controller="BorrowerProfile" asp-action="Index" class="nav-item @(currentController == "BorrowerProfile" ? "nav-item-active" : "")" aria-current="@(currentController == "BorrowerProfile" ? "page" : null)">@await Html.PartialAsync("Icons/_Icon", "users")<span>Borrower profiles</span></a>
        }
        @if (isAdmin && User.HasClaim("permission", DomainValues.Permissions.UserRoleManage))
        {
            <a asp-controller="Users" asp-action="Index" class="nav-item @(currentController == "Users" ? "nav-item-active" : "")" aria-current="@(currentController == "Users" ? "page" : null)">@await Html.PartialAsync("Icons/_Icon", "users")<span>Users &amp; roles</span></a>
        }
        @if (User.HasClaim("permission", DomainValues.Permissions.HistoryView))
        {
            <a asp-controller="BorrowingHistory" asp-action="Index" class="nav-item @(currentController == "BorrowingHistory" ? "nav-item-active" : "")" aria-current="@(currentController == "BorrowingHistory" ? "page" : null)">@await Html.PartialAsync("Icons/_Icon", "report")<span>Borrowing history</span></a>
        }
    </nav>

    @if (HostEnvironment.IsDevelopment() && (isBorrower || isCustodian || isAdmin))
    {
        <div class="border-t border-gray-200 pt-5">
            <p class="eyebrow mb-2">Switch role · demo</p>
            <div class="flex flex-wrap gap-2">
                @if (isBorrower) { <a asp-controller="Dashboard" asp-action="Borrower" class="role-switch">Brw</a> }
                @if (isCustodian) { <a asp-controller="Dashboard" asp-action="Custodian" class="role-switch">Cus</a> }
                @if (isAdmin) { <a asp-controller="Dashboard" asp-action="Administrator" class="role-switch">Adm</a> }
            </div>
        </div>
    }

    <form asp-controller="Account" asp-action="SignOutUser" method="post" class="mt-5 border-t border-gray-200 pt-4">
        @Html.AntiForgeryToken()
        <button type="submit" class="flex w-full items-center gap-3 px-2 py-2 text-left text-sm font-semibold text-gray-700 hover:text-ink focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
            @await Html.PartialAsync("Icons/_Icon", "signout")<span>Sign out</span>
        </button>
    </form>
</aside>