@model string
@{ var category = (Model ?? "").ToLowerInvariant(); }
<svg class="equipment-art" viewBox="0 0 300 180" fill="none" aria-hidden="true">
    <ellipse cx="150" cy="153" rx="104" ry="8" fill="#D6EBFF" />
    @if (category.Contains("laptop"))
    {
        <rect x="70" y="28" width="160" height="107" rx="10" fill="#4A6F94" />
        <rect x="78" y="36" width="144" height="88" rx="4" fill="#D6EBFF" />
        <path d="m70 135-24 16h208l-24-16H70Z" fill="#5980A6" />
        <path d="M125 140h50" stroke="#EBF5FF" stroke-width="4" stroke-linecap="round" />
    }
    else if (category.Contains("camera"))
    {
        <rect x="65" y="55" width="170" height="94" rx="16" fill="#5980A6" />
        <rect x="85" y="38" width="47" height="24" rx="7" fill="#4A6F94" />
        <circle cx="157" cy="102" r="43" fill="#4A6F94" />
        <circle cx="157" cy="102" r="31" fill="#D6EBFF" />
        <circle cx="157" cy="102" r="19" fill="#5980A6" />
        <circle cx="211" cy="76" r="6" fill="#EBF5FF" />
    }
    else if (category.Contains("projector"))
    {
        <rect x="48" y="59" width="204" height="88" rx="18" fill="#5980A6" />
        <path d="M48 77c0-10 8-18 18-18h168c10 0 18 8 18 18v12H48V77Z" fill="#D6EBFF" />
        <circle cx="205" cy="108" r="32" fill="#4A6F94" />
        <circle cx="205" cy="108" r="23" fill="#EBF5FF" />
        <circle cx="205" cy="108" r="12" fill="#5980A6" />
        <path d="M69 104h69m-69 10h69m-69 10h69" stroke="#D6EBFF" stroke-width="3" stroke-linecap="round" />
    }
    else if (category.Contains("speaker"))
    {
        <rect x="103" y="20" width="94" height="132" rx="15" fill="#4A6F94" />
        <circle cx="150" cy="57" r="21" fill="#5980A6" />
        <circle cx="150" cy="112" r="30" fill="#5980A6" />
        <circle cx="150" cy="112" r="17" fill="#D6EBFF" />
    }
    else
    {
        <rect x="71" y="56" width="158" height="93" rx="15" fill="#5980A6" />
        <path d="M118 56V39h64v17M71 93h158" stroke="#4A6F94" stroke-width="9" stroke-linejoin="round" />
        <rect x="134" y="86" width="32" height="19" rx="5" fill="#D6EBFF" />
    }
</svg>
