@using static ASI.Basecode.Resources.Views.Screen
<!DOCTYPE html>
<html lang="en" class="@(ViewBag.LoginViewport == true ? "auth-document" : string.Empty)" data-force-light="@(ViewBag.LoginView == true ? "true" : "false")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F2F2F3" />
    <script src="~/js/theme.js" asp-append-version="true"></script>
    <title>@ViewData["Title"] · Gearantee</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="ui-refresh min-h-screen bg-gray-50 font-sans text-ink antialiased @(ViewBag.LoginViewport == true ? "auth-body" : string.Empty)">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    @if (ViewBag.LoginView == true)
    {
        <main id="main-content" class="auth-page min-h-screen @(ViewBag.LoginViewport == true ? "auth-page--login" : string.Empty)">
            <partial name="_FlashMessages" />
            @RenderBody()
        </main>
    }
    else
    {
        <div class="app-frame lg:flex">
            <button id="sidebar-backdrop" class="fixed inset-0 z-30 hidden bg-black/50 lg:hidden" type="button" aria-label="Close navigation"></button>
            <partial name="_Sidebar" />
            <div class="workspace-main min-w-0 flex-1">
                <partial name="_Topbar" />
                <main id="main-content" class="workspace-content" role="main">
                    <partial name="_FlashMessages" />
                    @RenderBody()
                </main>
                <footer class="workspace-footer"><span>GEARANTEE / CAMPUS EQUIPMENT</span><span>@Copyright</span></footer>
            </div>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/toastr/toastr.min.js" asp-append-version="true"></script>
    <script src="~/js/flash-messages.js" asp-append-version="true"></script>
    <script src="~/js/notifications.js" asp-append-version="true"></script>
    <script src="~/js/app-shell.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="~/js/form-presentation.js" asp-append-version="true"></script>
</body>
</html>
