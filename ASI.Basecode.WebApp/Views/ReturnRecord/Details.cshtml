@model ASI.Basecode.Services.ServiceModels.Returns.ReturnRecordDetailsViewModel
@using ASI.Basecode.Services.Utilities
@{
    string OrDash(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    string When(DateTime? value) => value.HasValue ? value.Value.ToString("ddd d MMM yyyy · HH:mm") : "—";
    var returnTab = ViewData["ReturnTab"]?.ToString() ?? "Returned";
    var returnSearch = ViewData["ReturnSearch"]?.ToString() ?? string.Empty;
    var returnPage = ViewData["ReturnPage"]?.ToString() ?? "1";
}

<a asp-action="Index" asp-route-tab="@returnTab" asp-route-search="@returnSearch" asp-route-page="@returnPage" class="btn-secondary mb-6 min-h-10">Back to returns</a>


<div class="role-page detail-grid">
    <section aria-labelledby="return-heading" class="surface">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
                <p class="item-code">@Model.ReservationCode</p>
                <h2 id="return-heading" class="mt-1 font-display text-2xl font-semibold text-ink">@Model.ItemName</h2>
            </div>
            <partial name="Components/_StatusBadge" model="Model.DisplayStatus" />
        </div>

        @if (Model.DaysLate.HasValue)
        {
            <div class="mt-4 border-l-4 border-ink bg-gray-50 px-4 py-3 text-sm">
                <p class="text-xs font-semibold text-gray-500">Late return</p>
                <p class="mt-1 text-gray-700">Returned @Model.DaysLate day@(Model.DaysLate == 1 ? "" : "s") after the due time · penalty @OrDash(Model.PenaltyStatus).ToLowerInvariant()</p>
            </div>
        }

        <dl class="record-details mt-6 grid gap-4 text-sm sm:grid-cols-2">
            <div><dt class="text-xs text-gray-500">Returned at</dt><dd class="mt-1 font-medium text-gray-700">@When(Model.ReturnedAtLocal)</dd></div>
            <div><dt class="text-xs text-gray-500">Recorded at</dt><dd class="mt-1 font-medium text-gray-700">@When(Model.RecordedAtLocal)@(Model.IsBackdated ? " · back-dated" : "")</dd></div>
            <div><dt class="text-xs text-gray-500">Received by</dt><dd class="mt-1 font-medium text-gray-700">@OrDash(Model.ReceivedByName)</dd></div>
            <div><dt class="text-xs text-gray-500">Condition</dt><dd class="mt-1 font-medium text-gray-700">@ReturnInspection.Label(Model.ReturnedCondition)</dd></div>
            <div><dt class="text-xs text-gray-500">Resulting item status</dt><dd class="mt-1 font-medium text-gray-700">@ReturnInspection.Label(Model.ResultingItemStatus)</dd></div>
            <div class="sm:col-span-2"><dt class="text-xs text-gray-500">Inspection notes</dt><dd class="mt-1 whitespace-pre-line font-medium text-gray-700">@OrDash(Model.Notes)</dd></div>
        </dl>
    </section>

    <aside class="min-w-0 space-y-6">
        <section aria-labelledby="loan-heading" class="surface">
            <h3 id="loan-heading" class="font-display text-lg font-semibold text-ink">Loan</h3>
            <dl class="record-details mt-4 grid gap-4 text-sm sm:grid-cols-2">
                <div><dt class="text-xs text-gray-500">Item code</dt><dd class="mt-1 font-medium text-gray-700">@Model.ItemCode</dd></div>
                <div><dt class="text-xs text-gray-500">Category</dt><dd class="mt-1 font-medium text-gray-700">@Model.CategoryName</dd></div>
                <div><dt class="text-xs text-gray-500">Borrower</dt><dd class="mt-1 font-medium text-gray-700">@Model.BorrowerName</dd></div>
                <div><dt class="text-xs text-gray-500">School ID</dt><dd class="mt-1 font-medium text-gray-700">@OrDash(Model.SchoolId)</dd></div>
                <div><dt class="text-xs text-gray-500">Released</dt><dd class="mt-1 font-medium text-gray-700">@When(Model.ReleasedAtLocal)</dd></div>
                <div><dt class="text-xs text-gray-500">Due</dt><dd class="mt-1 font-medium text-gray-700">@Model.EndLabel</dd></div>
                <div class="sm:col-span-2"><dt class="text-xs text-gray-500">Location</dt><dd class="mt-1 font-medium text-gray-700">@Model.Location</dd></div>
            </dl>
        </section>
    </aside>
</div>
