@model ASI.Basecode.Services.ServiceModels.Dashboard.BorrowerDashboardModel
@using ASI.Basecode.Services.Utilities
@using ASI.Basecode.WebApp.Models.Dashboard
@inject ASI.Basecode.Services.Interfaces.IImageStorageService ImageStorage

<section class="borrower-summary" aria-label="Borrower summary">
    <partial name="Components/_KpiTile" model="@(new KpiTileModel { Label = "On loan now", Value = Model.ActiveLoanCount, Status = "Borrowed", Caption = Model.CurrentLoans.FirstOrDefault()?.ItemName ?? "No equipment currently on loan" })" />
    <partial name="Components/_KpiTile" model="@(new KpiTileModel { Label = "Pending requests", Value = Model.PendingCount, Status = "Pending", Caption = "Awaiting custodian decision" })" />
    <partial name="Components/_KpiTile" model="@(new KpiTileModel { Label = "Ready to collect", Value = Model.ApprovedAwaitingPickupCount, Status = "Awaiting Release", Caption = Model.UpcomingPickups.FirstOrDefault() is { } pickup ? $"{pickup.ItemName} · {pickup.LocationName}" : "Nothing is waiting for collection" })" />
    <partial name="Components/_KpiTile" model="@(new KpiTileModel { Label = "Overdue", Value = Model.OverdueCount, Status = "Overdue", Caption = Model.CurrentLoans.FirstOrDefault(row => row.DisplayStatus == "Overdue") is { } late ? $"Return {late.ItemName} as soon as possible" : "Nothing overdue" })" />
</section>

@if (!Model.HasProfile || !Model.IsEligible)
{
    <div class="mb-8 flex flex-wrap items-start justify-between gap-4 border-l-4 border-ink bg-white px-4 py-4 sm:px-6" role="status">
        <div>
            <p class="font-display text-lg font-semibold text-ink">Borrowing eligibility</p>
            <p class="mt-1 text-sm text-gray-500">Only active, eligible borrowers can submit equipment requests.</p>
            @if (!Model.HasProfile)
            {
                <p class="mt-2 text-sm text-gray-700">Your borrower profile is not set up yet. Contact an administrator for help.</p>
            }
            else
            {
                <p class="mt-2 text-sm text-gray-700">Your profile is not currently eligible to reserve equipment.</p>
            }
        </div>
        <partial name="Components/_StatusBadge" model="@(Model.IsEligible ? "Eligible" : "Ineligible")" />
    </div>
}

<div class="borrower-grid">
    <section class="surface" aria-labelledby="loans-heading">
        <div class="mb-4 flex flex-wrap items-end justify-between gap-3 border-b border-gray-200 pb-3">
            <div>
                <p class="eyebrow">Equipment in your care</p>
                <h2 id="loans-heading" class="font-display text-xl font-semibold text-ink">My equipment on loan</h2>
            </div>
            @if (User.HasClaim("permission", "equipment.browse"))
            {
                <a asp-controller="AvailabilityCalendar" asp-action="Index" class="text-sm font-semibold text-primary-strong underline underline-offset-4">Open calendar</a>
            }
        </div>

        @if (Model.CurrentLoans.Count == 0)
        {
            <partial name="Components/_EmptyState" model="@(new EmptyStateModel { Heading = "Nothing on loan", Message = "Your active equipment loans will appear here, with their return dates and condition details." })" />
        }
        else
        {
            <div class="loan-grid">
                @foreach (var loan in Model.CurrentLoans)
                {
                    <article class="loan-card">
                        @if (!string.IsNullOrWhiteSpace(loan.ImageUrl))
                        {
                            var imageSrc = await ImageStorage.CreateSignedUrlAsync(loan.ImageUrl, System.TimeSpan.FromMinutes(60));
                            <img src="@imageSrc" alt="@loan.ItemName" class="detail-image" />
                        }
                        else
                        {
                            <div class="equipment-placeholder" aria-label="No equipment image available">
                                <partial name="_EquipmentPlaceholder" model="loan.CategoryName" />
                            </div>
                        }
                        <div class="mt-4 flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <p class="item-code">@loan.ItemCode</p>
                                <h3 class="mt-1 truncate font-display text-lg font-semibold text-ink">@loan.ItemName</h3>
                            </div>
                            <partial name="Components/_StatusBadge" model="loan.DisplayStatus" />
                        </div>
                        <dl class="mt-4 grid grid-cols-2 gap-3 text-xs">
                            <div><dt class="text-gray-500">Due</dt><dd class="mt-1 font-medium text-gray-700">@loan.EndLabel</dd></div>
                            <div><dt class="text-gray-500">Released</dt><dd class="mt-1 font-medium text-gray-700">@(loan.ReleasedAtUtc.HasValue ? ManilaClock.ToLocal(loan.ReleasedAtUtc.Value).ToString("d MMM · HH:mm") : "—")</dd></div>
                        </dl>
                    </article>
                }
            </div>
        }
    </section>

    <div class="borrower-stack">
        <section class="surface" aria-labelledby="requests-heading">
            <div class="mb-4 flex items-end justify-between gap-3 border-b border-gray-200 pb-3">
                <div><p class="eyebrow">Latest activity</p><h2 id="requests-heading" class="font-display text-xl font-semibold text-ink">My requests</h2></div>
                <a asp-controller="Reservation" asp-action="Index" class="text-xs font-semibold text-primary-strong">View borrowing history</a>
            </div>
            @if (Model.RecentRequests.Count == 0)
            {
                <partial name="Components/_EmptyState" model="@(new EmptyStateModel { Heading = "No requests yet", Message = "Your reservation requests and their review status will show up here." })" />
            }
            else
            {
                <div class="activity-list">
                    @foreach (var request in Model.RecentRequests)
                    {
                        <article>
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <p class="item-code">@request.ReservationCode · @request.CategoryName</p>
                                    <h3 class="mt-1 truncate font-display text-base font-semibold text-ink">@request.ItemName</h3>
                                </div>
                                <partial name="Components/_StatusBadge" model="request.DisplayStatus" />
                            </div>
                            <p class="mt-2 text-xs text-gray-500">@request.StartLabel → @request.EndLabel</p>
                            <p class="mt-2 text-xs leading-5 text-gray-700">
                                @if (request.Status == "Rejected")
                                {
                                    <text>Rejected — @(string.IsNullOrWhiteSpace(request.RejectionReason) ? "No reason provided." : request.RejectionReason)</text>
                                }
                                else if (request.Status == "Approved")
                                {
                                    <text>@(string.IsNullOrWhiteSpace(request.ReviewerName) ? "Approved" : $"Approved by {request.ReviewerName}") · collect at @request.LocationName</text>
                                }
                                else
                                {
                                    @request.Purpose
                                }
                            </p>
                        </article>
                    }
                </div>
            }
        </section>

        <section class="surface" aria-labelledby="eligibility-heading">
            <div class="mb-4 flex items-center justify-between gap-3">
                <div><p class="eyebrow">Account standing</p><h2 id="eligibility-heading" class="font-display text-xl font-semibold text-ink">Eligibility</h2></div>
                <partial name="Components/_StatusBadge" model="@(Model.HasProfile && Model.IsEligible ? "Eligible" : "Ineligible")" />
            </div>
            <p class="text-sm leading-6 text-gray-700">Only active, eligible borrowers can submit requests.</p>
            <p class="mt-2 text-xs text-gray-500">@(Model.LateReturnCount == 0 ? "No late returns on record." : $"{Model.LateReturnCount} late return(s) on record.")</p>
            @if (User.HasClaim("permission", DomainValues.Permissions.EquipmentBrowse))
            {
                <a asp-controller="Catalog" asp-action="Index" class="btn-primary mt-5 w-full">Browse equipment</a>
            }
        </section>
    </div>
</div>
