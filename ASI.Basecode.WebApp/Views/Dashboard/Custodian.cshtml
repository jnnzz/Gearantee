@model ASI.Basecode.Services.ServiceModels.Dashboard.CustodianDashboardModel
@using ASI.Basecode.Services.Utilities
@using ASI.Basecode.WebApp.Models.Dashboard

@if (ViewData["DashboardUnavailable"] is true)
{
    <section class="table-surface p-8" aria-label="Dashboard unavailable">
        <p class="mb-4">Dashboard data is temporarily unavailable.</p>
        <a asp-action="Custodian" class="btn-secondary">Try again</a>
    </section>
    return;
}

<div class="role-page">
<section class="role-summary" aria-label="Custodian summary">
    <partial name="Components/_KpiTile" model="@(new KpiTileModel { Label = "Pending approval", Value = Model.PendingCount, Status = "Pending", Caption = $"{Model.PendingStartingSoonCount} starting within 24 hours" })" />
    <partial name="Components/_KpiTile" model="@(new KpiTileModel { Label = "To release today", Value = Model.PickupsTodayCount, Status = "Awaiting Release", Caption = Model.PickupsToday.FirstOrDefault() is { } pickup ? $"{pickup.BorrowerName} · {pickup.ItemName}" : "No scheduled pickups today" })" />
    <partial name="Components/_KpiTile" model="@(new KpiTileModel { Label = "Returns due today", Value = Model.ReturnsDueTodayCount, Status = "Due today", Caption = "Active loans due before end of day" })" />
    <partial name="Components/_KpiTile" model="@(new KpiTileModel { Label = "Overdue", Value = Model.OverdueCount, Status = "Overdue", Caption = "Needs follow-up" })" />
</section>

<div class="operations-grid">
    <section class="surface" aria-labelledby="desk-heading">
        <div class="surface-heading">
            <div><p class="eyebrow">@ViewData["PageDate"] · @(Model.PendingCount + Model.PickupsTodayCount + Model.ReturnsDueTodayCount + Model.OverdueCount) open task(s)</p><h2 id="desk-heading" class="font-display text-xl font-semibold text-ink">Today’s desk</h2></div>
            <button type="button" class="btn-secondary" onclick="window.location.reload()">Refresh</button>
        </div>

        @if (Model.Desk.Count == 0)
        {
            <partial name="Components/_EmptyState" model="@(new EmptyStateModel { Heading = "The desk is clear", Message = "Pending approvals, scheduled pickups, and returns due today will appear here." })" />
        }
        else
        {
            <div class="divide-y divide-gray-200">
                @foreach (var task in Model.Desk)
                {
                    <article class="desk-task">
                        <div class="desk-task-code">
                            <span class="eyebrow">@task.Kind</span>
                            <p class="item-code mt-1">@task.Row.ReservationCode @(task.Row.LoanCode is null ? "" : $"· {task.Row.LoanCode}")</p>
                        </div>
                        <div class="min-w-0 flex-1">
                            <h3 class="font-display text-lg font-semibold text-ink">@task.Row.ItemName <span class="font-sans text-sm font-normal text-gray-500">· @task.Row.BorrowerName</span></h3>
                            <p class="mt-1 text-xs text-gray-500">@task.Row.SchoolId · @task.Row.Department · @task.Row.LocationName</p>
                            <p class="mt-1 text-xs text-gray-500">@task.Row.StartLabel → @task.Row.EndLabel</p>
                        </div>
                        <div class="desk-task-actions">
                            <partial name="Components/_StatusBadge" model="task.Row.DisplayStatus" />
                            <span class="inline-flex items-center gap-2 border border-gray-200 px-3 py-2 text-xs font-semibold text-gray-500" aria-disabled="true">@(task.Kind == "APPROVE" ? "Review" : task.Kind == "RELEASE" ? "Release" : "Receive") <span class="soon-tag">Soon</span></span>
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <aside class="support-stack">
        <section class="surface" aria-labelledby="attention-heading">
            <div class="surface-heading"><p class="eyebrow">Operational alerts</p><h2 id="attention-heading" class="font-display text-xl font-semibold text-ink">Needs attention</h2></div>
            @if (Model.NeedsAttention.Count == 0)
            {
                <partial name="Components/_EmptyState" model="@(new EmptyStateModel { Heading = "No equipment alerts", Message = "Items requiring maintenance or availability attention will show up here." })" />
            }
            else
            {
                <ul class="divide-y divide-gray-200">
                    @foreach (var item in Model.NeedsAttention)
                    {
                        <li class="flex gap-3 py-4">
                            <span class="mt-0.5 flex size-7 shrink-0 items-center justify-center border border-gray-200 text-gray-700" aria-hidden="true">!</span>
                            <div class="min-w-0"><p class="font-display text-base font-semibold text-ink">@item.ItemName <span class="font-sans text-xs font-normal text-gray-500">@item.ItemCode</span></p><p class="mt-1 text-xs text-gray-500">@item.ItemStatus · @item.ConditionStatus · @item.LocationName</p></div>
                        </li>
                    }
                </ul>
            }
        </section>
        <section class="surface shortcut-card">
            <p class="eyebrow">Quick access</p><h2 class="mt-1 font-display text-xl font-semibold text-ink">Shortcuts</h2>
            <div class="mt-4 flex flex-wrap gap-x-5 gap-y-3 text-sm text-gray-500">
                @if (User.HasClaim("permission", "equipment.browse")) { <a asp-controller="Catalog" asp-action="Index" class="action-edit">Equipment</a> }
                @if (User.HasClaim("permission", "history.view")) { <a asp-controller="BorrowingHistory" asp-action="Index" class="action-edit">Reports</a> }
            </div>
        </section>
    </aside>
</div>
</div>
