@model ASI.Basecode.Services.ServiceModels.Dashboard.AdministratorDashboardModel
@using ASI.Basecode.WebApp.Models.Dashboard
@using System.Globalization

@section Styles {
    <link rel="stylesheet" href="~/css/admin-inventory.css" asp-append-version="true" />
}

<div class="role-page admin-dashboard">
<p class="admin-dashboard-caption">A clear view of equipment, people, and campus operations.</p>
<section class="role-summary admin-summary" aria-label="System summary">
    <article class="summary-card admin-kpi-card">
        <div class="admin-kpi-heading"><p class="eyebrow">Items tracked</p><span class="admin-kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="m4 7 8-4 8 4-8 4-8-4Z"/><path d="m4 7v10l8 4 8-4V7M12 11v10"/></svg></span></div>
        <p class="admin-kpi-value">@Model.TotalItems</p><p class="admin-kpi-caption">Across @Model.ActiveCategories active categories</p>
    </article>
    <article class="summary-card admin-kpi-card">
        <div class="admin-kpi-heading"><p class="eyebrow">Out on loan</p><span class="admin-kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M5 8h14l1 13H4L5 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg></span></div>
        <p class="admin-kpi-value">@Model.ActiveLoanCount</p><p class="admin-kpi-caption">@(Model.OverdueLoanCount == 0 ? "None overdue" : $"{Model.OverdueLoanCount} overdue")</p>
    </article>
    <article class="summary-card admin-kpi-card">
        <div class="admin-kpi-heading"><p class="eyebrow">Under maintenance</p><span class="admin-kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><path d="M14.5 6.5a5 5 0 0 0-6.8 6.8L3 18l3 3 4.7-4.7a5 5 0 0 0 6.8-6.8L14 13l-3-3 3.5-3.5Z"/></svg></span></div>
        <p class="admin-kpi-value">@Model.UnderMaintenanceCount</p><p class="admin-kpi-caption">@Model.DamagedAwaitingReviewCount awaiting damage review</p>
    </article>
    <article class="summary-card admin-kpi-card">
        <div class="admin-kpi-heading"><p class="eyebrow">Ineligible borrowers</p><span class="admin-kpi-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="9" cy="8" r="3"/><path d="M3 20v-1a6 6 0 0 1 12 0v1M17 8h4m-2-2v4"/></svg></span></div>
        <p class="admin-kpi-value">@Model.IneligibleBorrowerCount</p><p class="admin-kpi-caption">Blocked from new reservations</p>
    </article>
</section>

<div class="operations-grid admin-operations-grid">
    <section class="surface" aria-labelledby="inventory-heading">
        <div class="surface-heading">
            <div>
                <h2 id="inventory-heading" class="font-display text-xl font-semibold text-ink">Inventory by category</h2>
                <p class="surface-caption">Availability across your campus.</p>
            </div>
            <span class="status-badge rounded-full status-info">@Model.TotalItems items</span>
        </div>
        @if (Model.InventoryByCategory.Count == 0)
        {
            <partial name="Components/_EmptyState" model="@(new EmptyStateModel { Heading = "No active categories", Message = "Add active equipment categories to see inventory distribution." })" />
        }
        else
        {
            <div class="inventory-board">
                @foreach (var category in Model.InventoryByCategory)
                {
                    var total = category.Total;
                    var availablePercent = total == 0 ? 0 : Math.Clamp(category.Available * 100d / total, 0, 100);
                    var reservedPercent = total == 0 ? 0 : Math.Clamp(category.Reserved * 100d / total, 0, 100);
                    var borrowedPercent = total == 0 ? 0 : Math.Clamp(category.Borrowed * 100d / total, 0, 100);
                    var maintenancePercent = total == 0 ? 0 : Math.Clamp(category.Maintenance * 100d / total, 0, 100);
                    var unavailablePercent = total == 0 ? 0 : Math.Clamp(category.Unavailable * 100d / total, 0, 100);
                    <div class="inventory-category">
                        <div class="mb-2 flex items-baseline justify-between gap-3"><h3 class="font-display text-lg font-semibold text-ink">@category.Name</h3><span class="text-xs tabular-nums text-gray-500">@total item(s)</span></div>
                        <div class="inventory-bar flex h-3 w-full overflow-hidden bg-gray-200" role="img" aria-label="@category.Name: @category.Available available, @category.Reserved reserved, @category.Borrowed borrowed, @category.Maintenance under maintenance, @category.Unavailable unavailable">
                            <span class="h-full bg-white" style="width:@(availablePercent.ToString("0.##", CultureInfo.InvariantCulture))%"></span>
                            <span class="h-full bg-tint" style="width:@(reservedPercent.ToString("0.##", CultureInfo.InvariantCulture))%"></span>
                            <span class="h-full bg-primary" style="width:@(borrowedPercent.ToString("0.##", CultureInfo.InvariantCulture))%"></span>
                            <span class="h-full bg-gray-500" style="width:@(maintenancePercent.ToString("0.##", CultureInfo.InvariantCulture))%"></span>
                            <span class="h-full bg-ink" style="width:@(unavailablePercent.ToString("0.##", CultureInfo.InvariantCulture))%"></span>
                        </div>
                        <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[11px] text-gray-500">
                            <span>Available <strong class="font-semibold text-gray-700">@category.Available</strong></span><span>Reserved <strong class="font-semibold text-gray-700">@category.Reserved</strong></span><span>Borrowed <strong class="font-semibold text-gray-700">@category.Borrowed</strong></span><span>Maintenance <strong class="font-semibold text-gray-700">@category.Maintenance</strong></span><span>Unavailable <strong class="font-semibold text-gray-700">@category.Unavailable</strong></span>
                        </div>
                    </div>
                }
            </div>
        }
    </section>

    <aside class="support-stack admin-dashboard-support">
        <section class="surface admin-attention-panel" aria-labelledby="attention-heading">
            <div class="surface-heading"><h2 id="attention-heading" class="font-display text-xl font-semibold text-ink">Needs attention</h2></div>
            @if (Model.NeedsAttention.Count == 0)
            {
                <partial name="Components/_EmptyState" model="@(new EmptyStateModel { Heading = "Nothing needs attention", Message = "Overdue loans, damaged returns, and categories with no spare items will be listed here." })" />
            }
            else
            {
                <ul class="divide-y divide-gray-200">
                    @foreach (var alert in Model.NeedsAttention)
                    {
                        <li class="flex items-start justify-between gap-3 py-4">
                            <div class="flex min-w-0 gap-3"><span class="admin-alert-icon mt-0.5 shrink-0" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="8.5"/><path d="M12 7v5l3 2"/></svg></span><div class="min-w-0"><p class="font-display text-base font-semibold text-ink">@alert.Title</p><p class="mt-1 text-xs leading-5 text-gray-500">@alert.Detail</p></div></div>
                            @if (alert.IsAvailable)
                            {
                                <a href="@alert.Href" class="shrink-0 text-xs font-semibold text-primary-strong underline underline-offset-4">Open</a>
                            }
                            else
                            {
                                <span class="soon-tag shrink-0">Soon</span>
                            }
                        </li>
                    }
                </ul>
            }
        </section>
    </aside>
</div>
</div>
