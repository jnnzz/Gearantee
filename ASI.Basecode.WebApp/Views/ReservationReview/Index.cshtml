@model ASI.Basecode.Services.ServiceModels.Reservations.ReservationReviewIndexViewModel
@using ASI.Basecode.WebApp.Models.Dashboard
@{
    var successMessage = TempData["SuccessMessage"] as string;
    var errorMessage = TempData["ErrorMessage"] as string;
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="mb-5 border-l-4 border-primary bg-white px-4 py-3 text-sm" role="status">@successMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="mb-5 border-l-4 border-ink bg-white px-4 py-3 text-sm" role="alert">@errorMessage</div>
}

<section aria-labelledby="review-heading" class="min-w-0">
    <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
        <div>
            <h2 id="review-heading" class="font-display text-2xl font-semibold">Approval &amp; release</h2>
            <p class="mt-1 text-xs text-gray-500">Earliest window first · times are Philippine time</p>
        </div>
    </div>

    <form method="get" asp-action="Index" class="mb-4 flex flex-wrap items-center gap-2">
        <div class="flex-1">
            <label class="sr-only" for="review-search">Search reservation requests</label>
            <input id="review-search" name="search" value="@Model.Search" type="search" placeholder="Search item code, item name, school ID, or borrower" class="input w-full" />
        </div>
        <input type="hidden" name="status" value="@Model.StatusFilter" />
        <button type="submit" class="btn-primary">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-action="Index" asp-route-status="@(string.IsNullOrEmpty(Model.StatusFilter) ? null : Model.StatusFilter)" class="border border-gray-200 bg-white px-4 py-2 text-sm text-gray-700">Clear</a>
        }
    </form>

    <nav class="mb-4 flex flex-wrap gap-2" aria-label="Filter by status">
        @foreach (var tab in Model.Tabs)
        {
            var isActive = tab.Value == Model.StatusFilter;
            <a asp-action="Index" asp-route-status="@(string.IsNullOrEmpty(tab.Value) ? null : tab.Value)" asp-route-search="@(string.IsNullOrEmpty(Model.Search) ? null : Model.Search)"
               class="border px-3 py-2 text-sm @(isActive ? "border-primary bg-tint font-semibold text-primary-strong" : "border-gray-200 bg-white text-gray-700")"
               aria-current="@(isActive ? "page" : null)">@tab.Label <span class="ml-1 text-xs text-gray-500">@tab.Count</span></a>
        }
    </nav>

    @if (Model.Items.Count == 0)
    {
        <partial name="Components/_EmptyState" model="@(new EmptyStateModel { Heading = "Nothing to review", Message = "Requests appear here as soon as borrowers submit them." })" />
    }
    else
    {
        <div class="overflow-x-auto border border-gray-200 bg-white">
            <table class="w-full min-w-[680px] text-left text-sm">
                <thead class="border-b border-gray-200 bg-gray-50 font-display text-[11px] uppercase tracking-[0.12em] text-gray-700">
                    <tr>
                        <th scope="col" class="px-3 py-3">Reservation</th>
                        <th scope="col" class="px-3 py-3">Borrower</th>
                        <th scope="col" class="px-3 py-3">Equipment</th>
                        <th scope="col" class="px-3 py-3">When</th>
                        <th scope="col" class="px-3 py-3">Status</th>
                        <th scope="col" class="px-3 py-3"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @foreach (var reservation in Model.Items)
                    {
                        <tr class="align-middle">
                            <td class="px-3 py-3">
                                <p class="item-code">@reservation.ReservationCode</p>
                                <p class="mt-1 text-xs text-gray-500">Requested @reservation.RequestedAtLocal.ToString("d MMM · HH:mm")</p>
                            </td>
                            <td class="px-3 py-3">
                                <p class="font-semibold text-ink">@reservation.BorrowerName</p>
                                <p class="mt-1 text-xs text-gray-500">@reservation.SchoolId · @reservation.Department</p>
                            </td>
                            <td class="px-3 py-3">
                                <p class="font-semibold text-ink">@reservation.ItemName</p>
                                <p class="mt-1 text-xs text-gray-500">@reservation.ItemCode · @reservation.CategoryName</p>
                            </td>
                            <td class="px-3 py-3 text-gray-700">
                                @reservation.StartLocal.ToString("ddd d MMM · HH:mm")<br />
                                <span class="text-xs text-gray-500">to @reservation.EndLocal.ToString("ddd d MMM · HH:mm")</span>
                            </td>
                            <td class="px-3 py-3"><partial name="Components/_StatusBadge" model="reservation.DisplayStatus" /></td>
                            <td class="px-3 py-3 text-right">
                                <a asp-action="Details" asp-route-id="@reservation.ReservationId" class="text-sm font-semibold text-primary-strong underline underline-offset-4">Review<span class="sr-only"> @reservation.ReservationCode</span></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="mt-6 flex items-center justify-between text-xs text-gray-500" aria-label="Review pages">
            <span>Page @Model.Page of @Model.TotalPages · @Model.TotalCount request@(Model.TotalCount == 1 ? "" : "s")</span>
            <div class="flex gap-2">
                @if (Model.Page > 1)
                {
                    <a asp-action="Index" asp-route-status="@(string.IsNullOrEmpty(Model.StatusFilter) ? null : Model.StatusFilter)" asp-route-search="@(string.IsNullOrEmpty(Model.Search) ? null : Model.Search)" asp-route-page="@(Model.Page - 1)" class="border border-gray-200 bg-white px-3 py-2 text-gray-700">Previous</a>
                }
                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-action="Index" asp-route-status="@(string.IsNullOrEmpty(Model.StatusFilter) ? null : Model.StatusFilter)" asp-route-search="@(string.IsNullOrEmpty(Model.Search) ? null : Model.Search)" asp-route-page="@(Model.Page + 1)" class="border border-gray-200 bg-white px-3 py-2 text-gray-700">Next</a>
                }
            </div>
        </nav>
    }
</section>
