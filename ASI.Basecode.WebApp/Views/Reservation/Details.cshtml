@model ASI.Basecode.Services.ServiceModels.Reservations.ReservationDetailsViewModel
@using ASI.Basecode.WebApp.Models
@{
    string OrDash(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    string When(DateTime? value) => value.HasValue ? value.Value.ToString("ddd d MMM yyyy · HH:mm") : "—";
    var brandModel = string.Join(" ", new[] { Model.Brand, Model.Model }.Where(part => !string.IsNullOrWhiteSpace(part)));
    var statusNote = Model.DisplayStatus switch
    {
        "Pending" => "Waiting for a custodian to review your request.",
        "Awaiting Release" => "Approved. Pick the item up from the custodian at the start time.",
        "Borrowed" => "You have this item. Return it by the end time.",
        "Due today" => "You have this item. It's due back today.",
        "Overdue" => "This item is past its return time. Return it to the custodian as soon as possible.",
        "Returned" => "The item was returned. This reservation is complete.",
        "Missed pickup" => "Approved, but the item was never picked up before the end time.",
        "Rejected" => "A custodian declined this request.",
        "Cancelled" => "You cancelled this request.",
        "Expired" => "The start time passed before a custodian reviewed this request.",
        _ => null
    };
}

<a asp-action="Index" class="mb-6 inline-flex text-sm font-semibold text-primary-strong underline underline-offset-4">← Back to my reservations</a>


<div class="detail-grid">
    <section aria-labelledby="reservation-heading" class="surface">
        <div class="flex flex-wrap items-start justify-between gap-3">
            <div class="min-w-0">
                <p class="item-code">@Model.ReservationCode</p>
                <h2 id="reservation-heading" class="mt-1 font-display text-2xl font-semibold text-ink">@Model.ItemName</h2>
            </div>
            <partial name="Components/_StatusBadge" model="Model.DisplayStatus" />
        </div>
        @if (statusNote != null)
        {
            <p class="mt-3 text-sm text-gray-700">@statusNote</p>
        }
        @if (Model.Status == DomainValues.ReservationStatuses.Rejected && !string.IsNullOrWhiteSpace(Model.RejectionReason))
        {
            <div class="mt-4 border-l-4 border-ink bg-gray-50 px-4 py-3 text-sm">
                <p class="text-xs font-semibold text-gray-500">Reason</p>
                <p class="mt-1 text-gray-700">@Model.RejectionReason</p>
            </div>
        }

        <dl class="mt-6 grid gap-4 text-sm sm:grid-cols-2">
            <div><dt class="text-xs text-gray-500">Start</dt><dd class="mt-1 font-medium text-gray-700">@When(Model.StartLocal)</dd></div>
            <div><dt class="text-xs text-gray-500">End</dt><dd class="mt-1 font-medium text-gray-700">@When(Model.EndLocal)</dd></div>
            <div class="sm:col-span-2"><dt class="text-xs text-gray-500">Purpose</dt><dd class="mt-1 whitespace-pre-line font-medium text-gray-700">@Model.Purpose</dd></div>
        </dl>

        @if (Model.CanCancel)
        {
            <form asp-action="Cancel" asp-route-id="@Model.ReservationId" method="post" data-confirm-dialog="cancel-reservation-dialog"
                  class="mt-6 flex flex-wrap items-center justify-between gap-3 border-t border-gray-200 pt-5">
                <p class="text-xs text-gray-500">@(Model.Status == DomainValues.ReservationStatuses.Approved ? "Cancelling frees the item for other borrowers." : "You can cancel until the request is picked up.")</p>
                <button type="submit" class="btn-danger">Cancel reservation</button>
            </form>

            <partial name="Components/_ConfirmDialog" model="@(new ConfirmDialogModel
            {
                Id = "cancel-reservation-dialog",
                IsDestructive = true,
                Title = $"Cancel {Model.ReservationCode}?",
                Message = Model.Status == DomainValues.ReservationStatuses.Approved
                    ? "Your approved booking will be released and other borrowers can reserve this time. This can't be undone."
                    : "Your request will be withdrawn before a custodian reviews it. This can't be undone.",
                Detail = $"{Model.ItemName} · {When(Model.StartLocal)} → {When(Model.EndLocal)}",
                ConfirmText = "Yes, cancel it",
                CancelText = "Keep reservation"
            })" />
        }
    </section>

    <aside class="min-w-0 space-y-6">
        <section aria-labelledby="item-heading" class="surface">
            <h3 id="item-heading" class="font-display text-lg font-semibold text-ink">Equipment</h3>
            <dl class="mt-4 grid gap-4 text-sm sm:grid-cols-2">
                <div><dt class="text-xs text-gray-500">Item code</dt><dd class="mt-1 font-medium text-gray-700">@Model.ItemCode</dd></div>
                <div><dt class="text-xs text-gray-500">Category</dt><dd class="mt-1 font-medium text-gray-700">@Model.CategoryName</dd></div>
                <div><dt class="text-xs text-gray-500">Brand / model</dt><dd class="mt-1 font-medium text-gray-700">@OrDash(brandModel)</dd></div>
                <div><dt class="text-xs text-gray-500">Location</dt><dd class="mt-1 font-medium text-gray-700">@Model.Location</dd></div>
            </dl>
        </section>

        <section aria-labelledby="timeline-heading" class="surface">
            <h3 id="timeline-heading" class="font-display text-lg font-semibold text-ink">Timeline</h3>
            <ol class="timeline mt-4 space-y-3 text-sm">
                <li><p class="text-xs text-gray-500">Requested</p><p class="mt-1 font-medium text-gray-700">@When(Model.RequestedAtLocal)</p></li>
                @if (Model.ReviewedAtLocal.HasValue)
                {
                    <li><p class="text-xs text-gray-500">@(Model.Status == DomainValues.ReservationStatuses.Rejected ? "Rejected" : "Approved")@(Model.ReviewerName == null ? "" : " by " + Model.ReviewerName)</p><p class="mt-1 font-medium text-gray-700">@When(Model.ReviewedAtLocal)</p></li>
                }
                @if (Model.ReleasedAtLocal.HasValue)
                {
                    <li><p class="text-xs text-gray-500">Picked up</p><p class="mt-1 font-medium text-gray-700">@When(Model.ReleasedAtLocal)</p></li>
                }
                @if (Model.ReturnedAtLocal.HasValue)
                {
                    <li><p class="text-xs text-gray-500">Returned@(string.IsNullOrWhiteSpace(Model.ReturnedCondition) ? "" : " · " + Model.ReturnedCondition)</p><p class="mt-1 font-medium text-gray-700">@When(Model.ReturnedAtLocal)</p></li>
                }
                @if (Model.CancelledAtLocal.HasValue)
                {
                    <li><p class="text-xs text-gray-500">Cancelled</p><p class="mt-1 font-medium text-gray-700">@When(Model.CancelledAtLocal)</p></li>
                }
            </ol>
        </section>
    </aside>
</div>

@section Scripts {
    <script src="~/js/confirm-dialog.js" asp-append-version="true"></script>
}
