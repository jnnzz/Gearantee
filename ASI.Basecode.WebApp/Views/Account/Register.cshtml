@model RegisterViewModel
@{
    ViewBag.LoginView = true;
    ViewData["Title"] = "Create your account";
}

<div class="register-page">
    <section class="register-card">
        <a asp-controller="Account" asp-action="Login" class="inline-flex w-48 items-center">
            @await Html.PartialAsync("_BrandLogo")
        </a>
        <p class="eyebrow mt-8">Campus equipment borrowing</p>
        <h1>Create your account</h1>
        <p class="mb-7 mt-2 text-sm leading-6 text-gray-500">Create a borrower account. An administrator must confirm your eligibility before you can submit a request.</p>

        <form asp-action="Register" asp-controller="Account" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
            <div class="grid gap-x-5 gap-y-4 sm:grid-cols-2">
                <div>
                    <label asp-for="UserCode" class="field-label"></label>
                    <input asp-for="UserCode" class="input" autocomplete="username" />
                    <span asp-validation-for="UserCode" class="field-validation-error"></span>
                </div>
                <div>
                    <label asp-for="Email" class="field-label"></label>
                    <input asp-for="Email" class="input" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>
                <div>
                    <label asp-for="FirstName" class="field-label"></label>
                    <input asp-for="FirstName" class="input" autocomplete="given-name" />
                    <span asp-validation-for="FirstName" class="field-validation-error"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="field-label"></label>
                    <input asp-for="LastName" class="input" autocomplete="family-name" />
                    <span asp-validation-for="LastName" class="field-validation-error"></span>
                </div>
                <div>
                    <label asp-for="Department" class="field-label"></label>
                    <input asp-for="Department" class="input" autocomplete="organization" />
                    <span asp-validation-for="Department" class="field-validation-error"></span>
                </div>
                <div>
                    <label asp-for="ContactNumber" class="field-label"></label>
                    <input asp-for="ContactNumber" class="input" autocomplete="tel" />
                    <span asp-validation-for="ContactNumber" class="field-validation-error"></span>
                </div>
                <div>
                    <label asp-for="Password" class="field-label"></label>
                    <input asp-for="Password" class="input" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="field-label"></label>
                    <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>
            </div>
            <button class="btn-primary mt-7 w-full py-3" type="submit">Create account</button>
        </form>

        <p class="mt-6 text-center text-sm text-gray-500">Already registered? <a asp-controller="Account" asp-action="Login" class="font-semibold text-primary-strong underline underline-offset-4">Sign in</a></p>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
