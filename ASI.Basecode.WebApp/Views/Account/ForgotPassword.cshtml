@model ForgotPasswordViewModel
@{
    ViewBag.LoginView = true;
    ViewBag.LoginPage = true;
    ViewData["Title"] = "Forgot Password";
}

<div class="login-page forgot-password-page">
    <partial name="_AuthStory" />

    <div class="login-form-shell">
        <section class="login-panel forgot-panel" aria-labelledby="forgot-password-heading">
            <partial name="_AuthBrand" />
            <a class="forgot-back" asp-controller="Account" asp-action="Login">← Back to sign in</a>
            <h2 id="forgot-password-heading">Forgot password</h2>
            <p class="login-intro forgot-intro">We will send a six-digit verification code to your registered school address.</p>


            <form asp-action="ForgotPassword" asp-controller="Account" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

                <div class="login-field">
                    <label asp-for="Email">Registered email</label>
                    <input asp-for="Email" class="input" type="email"
                           autocomplete="email"
                           placeholder="you@school.edu" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <button class="btn-primary w-full py-3 text-sm" type="submit">Send verification code</button>
            </form>

            <p class="forgot-note">For your protection, the same confirmation is shown whether or not the address is registered.</p>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
