@model ResetPasswordViewModel
@{
    ViewBag.LoginView = true;
    ViewBag.LoginPage = true;
    ViewData["Title"] = "Reset Password";
}

<div class="login-page forgot-password-page">
    <partial name="_AuthStory" />

    <div class="login-form-shell">
        <section class="login-panel forgot-panel" aria-labelledby="reset-password-heading">
            <partial name="_AuthBrand" />
            <a class="forgot-back" asp-controller="Account" asp-action="Login">Back to sign in</a>
            <h2 id="reset-password-heading">Reset password</h2>
            <p class="login-intro forgot-intro">Enter a new password for your Gearantee account.</p>

            <form asp-action="ResetPassword" asp-controller="Account" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
                <input asp-for="UserId" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <div class="login-field">
                    <label asp-for="Password">New password</label>
                    <input asp-for="Password" class="input" autocomplete="new-password" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <div class="login-field">
                    <label asp-for="ConfirmPassword">Confirm password</label>
                    <input asp-for="ConfirmPassword" class="input" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>
                </div>

                <button class="btn-primary w-full py-3 text-sm" type="submit">Reset password</button>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
