@model LoginViewModel
@{
    ViewBag.LoginView = true;
    ViewBag.LoginPage = true;
    ViewData["Title"] = "Login";
}

<div class="login-page">
    <partial name="_AuthStory" />

    <div class="login-form-shell">
        <section class="login-panel" aria-labelledby="login-heading">
            <partial name="_AuthBrand" />
            <h2 id="login-heading">Sign in</h2>
            <p class="login-intro">Use your school email or student / faculty ID.</p>

            <form id="login-form" asp-action="Login" asp-controller="Account" method="post">
                <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                <input type="hidden" name="RememberMe" value="false" />
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

                <div class="login-field">
                    <label asp-for="UserId">Email or school ID</label>
                    <input asp-for="UserId" class="input"
                           autocomplete="username"
                           placeholder="mvillanueva@school.edu" />
                    <span asp-validation-for="UserId" class="field-validation-error"></span>
                </div>

                <div class="login-field">
                    <label asp-for="Password"></label>
                    <div class="login-password-wrap">
                        <input asp-for="Password" type="password" class="input"
                               autocomplete="current-password"
                               placeholder="••••••••••" />
                        <button id="toggle-password" class="login-password-toggle" type="button"
                                aria-controls="Password" aria-label="Show password">
                            Show
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <div class="login-options">
                    <a href="/Account/ForgotPassword">Forgot password?</a>
                </div>

                <button id="login-submit" class="btn-primary w-full py-3 text-sm disabled:cursor-wait disabled:opacity-60" type="submit">Sign in</button>
            </form>

        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const passwordInput = document.getElementById("Password");
        const passwordToggle = document.getElementById("toggle-password");
        const loginForm = document.getElementById("login-form");
        const submitButton = document.getElementById("login-submit");

        if (passwordToggle && passwordInput) {
            passwordToggle.addEventListener("click", function () {
                const isHidden = passwordInput.type === "password";
                passwordInput.type = isHidden ? "text" : "password";
                passwordToggle.textContent = isHidden ? "Hide" : "Show";
                passwordToggle.setAttribute(
                    "aria-label",
                    isHidden ? "Hide password" : "Show password");
            });
        }

        loginForm.addEventListener("submit", function () {
            if (window.jQuery && !$(loginForm).valid()) {
                return;
            }

            if (!window.jQuery && !loginForm.checkValidity()) {
                return;
            }

            submitButton.disabled = true;
            submitButton.textContent = "Signing in...";
        });
    </script>
}
