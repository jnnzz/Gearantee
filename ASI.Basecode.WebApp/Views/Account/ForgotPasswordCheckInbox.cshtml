@model VerifyPasswordResetOtpViewModel
@{
    ViewBag.LoginView = true;
    ViewBag.LoginPage = true;
    ViewData["Title"] = "Check Your Inbox";
}

<div class="login-page forgot-password-page">
    <partial name="_AuthStory" />

    <div class="login-form-shell">
        <section class="login-panel forgot-check-panel" aria-labelledby="forgot-check-heading">
            <partial name="_AuthBrand" />
            <div class="forgot-inbox-icon" aria-hidden="true">
                <svg viewBox="0 0 17 17" role="presentation">
                    <rect x="1.5" y="3.2" width="14" height="10.6"></rect>
                    <path d="M2 4.1 8.5 9l6.5-4.9"></path>
                </svg>
            </div>

            <h2 id="forgot-check-heading">Check your inbox</h2>
            <p class="forgot-check-copy">
                If this School ID is linked to an eligible account with a registered email, password-reset instructions will be sent.
            </p>
            <p class="forgot-check-expiry">The code expires in 10 minutes and can be used once.</p>

            <form asp-controller="Account" asp-action="VerifyPasswordResetOtp" method="post">
                <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
                <input asp-for="SchoolId" type="hidden" />

                <div class="login-field">
                    <label asp-for="Otp">Verification code</label>
                    <input asp-for="Otp" class="input" inputmode="numeric"
                           autocomplete="one-time-code" maxlength="6" placeholder="000000" />
                    <span asp-validation-for="Otp" class="field-validation-error"></span>
                </div>

                <button class="btn-primary w-full py-3 text-sm" type="submit">Verify code</button>
            </form>

            <div class="forgot-check-actions">
                <a class="forgot-check-back" asp-controller="Account" asp-action="Login">Back to sign in</a>
                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    <input name="SchoolId" type="hidden" value="@Model.SchoolId" />
                    <button class="forgot-check-resend" type="submit">Resend</button>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
