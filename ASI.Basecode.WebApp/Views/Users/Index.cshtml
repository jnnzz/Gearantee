@model ASI.Basecode.Services.ServiceModels.UserAdministration.UserAccountsIndexViewModel
@using ASI.Basecode.Services.ServiceModels.UserAdministration
@{
    var matrix = ViewData["PermissionMatrix"] as RolePermissionsViewModel;
    var successMessage = ViewData["SuccessMessage"] as string;
    var errorMessage = ViewData["ErrorMessage"] as string;
    string RoleCode(string name) => name switch
    {
        "Borrower" => "BRW",
        "Custodian" => "CUS",
        "Administrator" => "ADM",
        _ => name
    };
}

@if (!string.IsNullOrWhiteSpace(successMessage))
{
    <div class="mb-5 border-l-4 border-primary bg-white px-4 py-3 text-sm" role="status">@successMessage</div>
}
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="mb-5 border-l-4 border-ink bg-white px-4 py-3 text-sm" role="alert">@errorMessage</div>
}

<div class="grid items-start gap-8 xl:grid-cols-[minmax(0,1.2fr)_minmax(420px,0.8fr)]">
    <section aria-labelledby="accounts-heading" class="min-w-0">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
            <div>
                <h2 id="accounts-heading" class="font-display text-2xl font-semibold">User accounts</h2>
                <p class="mt-1 text-xs text-gray-500">@Model.TotalCount account@(Model.TotalCount == 1 ? "" : "s") · deactivation preserves borrowing history</p>
            </div>
            <div class="flex flex-wrap gap-2">
                <a asp-action="Import" class="border border-gray-200 bg-white px-3 py-2 text-sm font-semibold text-primary-strong">Import CSV</a>
                <a asp-action="Create" class="btn-primary min-h-10">+ New user</a>
            </div>
        </div>

        <form method="get" asp-action="Index" class="mb-4 grid gap-2 sm:grid-cols-[minmax(180px,1fr)_150px_165px_auto]">
            <label class="sr-only" for="user-search">Search accounts</label>
            <input id="user-search" name="search" value="@Model.Search" type="search" placeholder="Search name, email, user code" class="input md:hidden" />
            <input type="hidden" name="search" value="@Model.Search" class="hidden md:block" />
            <label class="sr-only" for="user-status">Filter by status</label>
            <select id="user-status" name="status" class="input">
                <option value="">All statuses</option>
                <option value="active" selected="@(Model.StatusFilter == "active")">Active</option>
                <option value="deactivated" selected="@(Model.StatusFilter == "deactivated")">Deactivated</option>
            </select>
            <label class="sr-only" for="user-role">Filter by role</label>
            <select id="user-role" name="role" class="input">
                <option value="">All roles</option>
                @foreach (var role in Model.Roles)
                {
                    <option value="@role.Id" selected="@(Model.RoleFilter == role.Id)">@role.Name</option>
                }
            </select>
            <button type="submit" class="btn-primary">Search</button>
        </form>

        <div class="overflow-x-auto border border-gray-200 bg-white">
            <table class="w-full min-w-[620px] text-left text-sm">
                <thead class="border-b border-gray-200 bg-gray-50 font-display text-[11px] uppercase tracking-[0.12em] text-gray-700">
                    <tr>
                        <th scope="col" class="px-3 py-3">User</th>
                        <th scope="col" class="px-3 py-3">Email</th>
                        <th scope="col" class="px-3 py-3">Role</th>
                        <th scope="col" class="px-3 py-3">Status</th>
                        <th scope="col" class="px-3 py-3"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-200">
                    @if (Model.Users.Count == 0)
                    {
                        <tr><td colspan="5" class="px-4 py-12 text-center text-sm text-gray-500">No accounts match these filters.</td></tr>
                    }
                    @foreach (var user in Model.Users)
                    {
                        var initials = string.Concat(user.DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(part => part[0])).ToUpperInvariant();
                        <tr class="align-middle">
                            <td class="px-3 py-3">
                                <div class="flex items-center gap-3">
                                    <span class="flex size-9 shrink-0 items-center justify-center bg-tint font-display text-xs font-semibold text-primary-strong" aria-hidden="true">@initials</span>
                                    <div class="min-w-0">
                                        <div class="font-semibold text-ink">@user.DisplayName</div>
                                        <div class="item-code mt-0.5">@user.UserCode</div>
                                    </div>
                                </div>
                            </td>
                            <td class="px-3 py-3 text-gray-700">@user.Email</td>
                            <td class="px-3 py-3">
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var role in user.Roles)
                                    {
                                        <span class="border border-gray-200 px-2 py-1 text-[11px] text-gray-700">@role</span>
                                    }
                                </div>
                            </td>
                            <td class="px-3 py-3">
                                <span class="inline-flex border px-2 py-1 text-[11px] @(user.IsActive ? "border-primary text-primary-strong" : "border-gray-200 text-gray-500")">@(user.IsActive ? "Active" : "Deactivated")</span>
                            </td>
                            <td class="px-3 py-3 text-right">
                                <a asp-action="Edit" asp-route-id="@user.Id" class="text-xs font-semibold text-primary-strong underline underline-offset-4">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <nav class="mt-3 flex items-center justify-between text-xs text-gray-500" aria-label="User account pages">
            <span>Page @Model.Page of @Model.TotalPages</span>
            <div class="flex gap-2">
                @if (Model.Page > 1)
                {
                    <a asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.StatusFilter" asp-route-role="@Model.RoleFilter" asp-route-page="@(Model.Page - 1)" class="border border-gray-200 bg-white px-3 py-2 text-gray-700">Previous</a>
                }
                @if (Model.Page < Model.TotalPages)
                {
                    <a asp-action="Index" asp-route-search="@Model.Search" asp-route-status="@Model.StatusFilter" asp-route-role="@Model.RoleFilter" asp-route-page="@(Model.Page + 1)" class="border border-gray-200 bg-white px-3 py-2 text-gray-700">Next</a>
                }
            </div>
        </nav>
    </section>

    <section aria-labelledby="permissions-heading" class="min-w-0 border border-gray-200 bg-white p-4 sm:p-5">
        <div class="mb-4 flex flex-wrap items-start justify-between gap-3">
            <div>
                <h2 id="permissions-heading" class="font-display text-2xl font-semibold">Role permissions</h2>
                <p class="mt-1 max-w-xl text-xs leading-5 text-gray-500">Choose which dashboard pages and actions each role can reach. Changes take effect on the next permission refresh.</p>
            </div>
        </div>

        <form asp-action="Permissions" method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>
            @foreach (var role in matrix.Roles)
            {
                <input type="hidden" name="RoleStamps[@role.Id]" value="@matrix.RoleStamps[role.Id]" />
            }
            <div class="overflow-x-auto">
                <table class="w-full min-w-[440px] text-left text-xs">
                    <thead class="border-b border-gray-200 text-[10px] font-semibold uppercase tracking-[0.12em] text-gray-500">
                        <tr>
                            <th scope="col" class="py-3 pr-2">Capability</th>
                            @foreach (var role in matrix.Roles)
                            {
                                <th scope="col" class="px-2 py-3 text-center" title="@role.Name">@RoleCode(role.Name)</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                        @for (var index = 0; index < matrix.Permissions.Count; index++)
                        {
                            var permission = matrix.Permissions[index];
                            <tr>
                                <td class="py-3 pr-2 leading-4 text-gray-700">
                                    @permission.Description
                                    <input type="hidden" name="Assignments[@index].PermissionName" value="@permission.Name" />
                                </td>
                                @foreach (var role in matrix.Roles)
                                {
                                    var checkedValue = permission.GrantedRoleIds.Contains(role.Id);
                                    var locked = permission.IsLocked && role.Name == "Administrator";
                                    <td class="px-2 py-3 text-center">
                                        @if (locked && checkedValue)
                                        {
                                            <input type="hidden" name="Assignments[@index].RoleIds" value="@role.Id" />
                                        }
                                        <input type="checkbox"
                                               name="Assignments[@index].RoleIds"
                                               value="@role.Id"
                                               checked="@(checkedValue ? "checked" : null)"
                                               disabled="@(permission.IsLocked)"
                                               aria-label="@permission.Description — @role.Name"
                                               class="size-4 accent-primary-strong disabled:cursor-not-allowed" />
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="mt-3 text-[11px] leading-4 text-gray-500">The Administrator capability is required to administer roles and cannot be reassigned or removed.</p>
            <div class="mt-4 flex justify-end">
                <button type="submit" class="btn-primary">Save permissions</button>
            </div>
        </form>
    </section>
</div>
