@model ASI.Basecode.Services.ServiceModels.Category.EquipmentManagementIndexViewModel
@{
    var hasCategoryFilters = !string.IsNullOrWhiteSpace(Model.CategorySearch) || !string.IsNullOrWhiteSpace(Model.CategoryStatusFilter);
    var hasEquipmentFilters = !string.IsNullOrWhiteSpace(Model.Equipment.Search) ||
        !string.IsNullOrWhiteSpace(Model.Equipment.StatusFilter) || Model.Equipment.CategoryId.HasValue;
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin-inventory.css" asp-append-version="true" />
}

<div class="role-page inventory-workspace space-y-5">
    <section class="surface inventory-section" aria-labelledby="categories-heading">
        <div class="surface-heading inventory-section-heading">
            <div>
                <h2 id="categories-heading" class="surface-title">Equipment categories</h2>
                <p class="surface-caption">Organize the equipment your campus relies on.</p>
            </div>
            <button type="button" id="btn-open-create-modal" class="btn-primary">+ New category</button>
        </div>

        <form method="get" asp-action="Index" class="inventory-filter-row category-filters" role="search" aria-label="Filter categories">
            <input type="hidden" name="tab" value="categories" />
            <input type="hidden" name="equipmentSearch" value="@Model.Equipment.Search" />
            <input type="hidden" name="equipmentStatus" value="@Model.Equipment.StatusFilter" />
            <input type="hidden" name="equipmentCategoryId" value="@Model.Equipment.CategoryId" />
            <input type="hidden" name="equipmentPage" value="@Model.Equipment.Page" />
            <label class="sr-only" for="category-search">Search categories</label>
            <input id="category-search" name="categorySearch" value="@Model.CategorySearch" type="search" class="input" placeholder="Search categories" />
            <label class="sr-only" for="category-status">Filter categories by status</label>
            <select id="category-status" name="categoryStatus" class="input">
                <option value="">All statuses</option>
                <option value="active" selected="@(Model.CategoryStatusFilter == "active" ? "selected" : null)">Active</option>
                <option value="inactive" selected="@(Model.CategoryStatusFilter == "inactive" ? "selected" : null)">Inactive</option>
            </select>
            <button type="submit" class="btn-secondary">Filter</button>
            @if (hasCategoryFilters)
            {
                <a asp-action="Index" asp-route-tab="categories"
                   asp-route-equipmentSearch="@Model.Equipment.Search"
                   asp-route-equipmentStatus="@Model.Equipment.StatusFilter"
                   asp-route-equipmentCategoryId="@Model.Equipment.CategoryId"
                   asp-route-equipmentPage="@Model.Equipment.Page" class="inventory-clear-link">Clear</a>
            }
        </form>

        @if (Model.Categories.Count == 0)
        {
            <div class="inventory-empty-state" role="status">
                <h3>@(hasCategoryFilters ? "No matching categories" : "No categories yet")</h3>
                <p>@(hasCategoryFilters ? "Try changing or clearing the category filters." : "Create a category to start organizing equipment.")</p>
            </div>
        }
        else
        {
            <div class="category-card-grid">
                @foreach (var category in Model.Categories)
                {
                    <article class="category-summary-card">
                        <div class="flex items-start justify-between gap-2">
                            <span class="item-code">@category.CategoryCode</span>
                            <span class="status-badge rounded-full @(category.IsActive ? "status-info" : "status-neutral")">@(category.IsActive ? "Active" : "Inactive")</span>
                        </div>
                        <h3 class="category-summary-name">@category.CategoryName</h3>
                        <p class="category-summary-count">@category.ItemCount tracked item@(category.ItemCount == 1 ? "" : "s")</p>
                        @if (!string.IsNullOrWhiteSpace(category.Description))
                        {
                            <p class="category-summary-description">@category.Description</p>
                        }
                        <div class="category-summary-actions">
                            <button type="button" class="btn-open-edit" data-id="@category.CategoryId"
                                    data-code="@category.CategoryCode" data-name="@category.CategoryName"
                                    data-description="@category.Description" aria-label="Edit @category.CategoryName">Edit</button>
                            <button type="button" class="btn-open-status" data-id="@category.CategoryId"
                                    data-name="@category.CategoryName" data-active="@category.IsActive.ToString().ToLowerInvariant()">
                                @(category.IsActive ? "Deactivate" : "Activate")
                            </button>
                        </div>
                    </article>
                }
            </div>
        }

        <partial name="Components/_Pagination" model="@(new PaginationViewModel
        {
            Page = Model.CategoryPage, TotalPages = Model.CategoryTotalPages, TotalCount = Model.CategoryTotalCount,
            Label = "Category pages", PageParameter = "categoryPage",
            Routes = {
                ["tab"] = "categories", ["categorySearch"] = Model.CategorySearch, ["categoryStatus"] = Model.CategoryStatusFilter,
                ["equipmentSearch"] = Model.Equipment.Search, ["equipmentStatus"] = Model.Equipment.StatusFilter,
                ["equipmentCategoryId"] = Model.Equipment.CategoryId?.ToString(), ["equipmentPage"] = Model.Equipment.Page.ToString()
            }
        })" />
    </section>

    <section class="surface inventory-section" aria-labelledby="equipment-heading">
        <div class="surface-heading inventory-section-heading">
            <div>
                <h2 id="equipment-heading" class="surface-title">Equipment items</h2>
                <p class="surface-caption">Track condition, availability, and storage location.</p>
            </div>
            <a asp-action="CreateEquipment" class="btn-primary">+ Register item</a>
        </div>

        <form method="get" asp-action="Index" class="inventory-filter-row equipment-filters" role="search" aria-label="Filter equipment items">
            <input type="hidden" name="tab" value="equipment" />
            <input type="hidden" name="categorySearch" value="@Model.CategorySearch" />
            <input type="hidden" name="categoryStatus" value="@Model.CategoryStatusFilter" />
            <input type="hidden" name="categoryPage" value="@Model.CategoryPage" />
            <label class="sr-only" for="equipment-search">Search equipment items</label>
            <input id="equipment-search" name="equipmentSearch" value="@Model.Equipment.Search" type="search" class="input" placeholder="Search item, code, serial, or location" />
            <label class="sr-only" for="equipment-category-filter">Filter by category</label>
            <select id="equipment-category-filter" name="equipmentCategoryId" class="input">
                <option value="">All categories</option>
                @foreach (var category in Model.Equipment.Categories)
                {
                    <option value="@category.CategoryId" selected="@(Model.Equipment.CategoryId == category.CategoryId ? "selected" : null)">@category.CategoryName@(category.IsActive ? "" : " (Inactive)")</option>
                }
            </select>
            <label class="sr-only" for="equipment-status-filter">Filter by item status</label>
            <select id="equipment-status-filter" name="equipmentStatus" class="input">
                <option value="" selected="@(string.IsNullOrWhiteSpace(Model.Equipment.StatusFilter) ? "selected" : null)">Active inventory</option>
                <option value="Available" selected="@(Model.Equipment.StatusFilter == "Available" ? "selected" : null)">Available</option>
                <option value="Borrowed" selected="@(Model.Equipment.StatusFilter == "Borrowed" ? "selected" : null)">Borrowed</option>
                <option value="UnderMaintenance" selected="@(Model.Equipment.StatusFilter == "UnderMaintenance" ? "selected" : null)">Under maintenance</option>
                <option value="Unavailable" selected="@(Model.Equipment.StatusFilter == "Unavailable" ? "selected" : null)">Unavailable</option>
                <option value="archived" selected="@(Model.Equipment.StatusFilter == "archived" ? "selected" : null)">Archived</option>
            </select>
            <button type="submit" class="btn-secondary">Filter</button>
            @if (hasEquipmentFilters)
            {
                <a asp-action="Index" asp-route-tab="equipment"
                   asp-route-categorySearch="@Model.CategorySearch" asp-route-categoryStatus="@Model.CategoryStatusFilter"
                   asp-route-categoryPage="@Model.CategoryPage" class="inventory-clear-link">Clear</a>
            }
        </form>

        <div class="table-surface inventory-table-wrap">
            <table class="inventory-table">
                <thead>
                    <tr>
                        <th scope="col">Item code</th>
                        <th scope="col">Name / model</th>
                        <th scope="col">Category</th>
                        <th scope="col">Serial no.</th>
                        <th scope="col">Condition</th>
                        <th scope="col">Status</th>
                        <th scope="col">Location</th>
                        <th scope="col"><span class="sr-only">Actions</span></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Equipment.Items.Count == 0)
                    {
                        <tr><td colspan="8" class="inventory-table-empty">
                            <h3>@(hasEquipmentFilters ? "No equipment items match these filters." : "No equipment registered")</h3>
                            <p>@(hasEquipmentFilters ? "Try changing or clearing the equipment filters." : "Register an item to begin tracking campus inventory.")</p>
                        </td></tr>
                    }
                    @foreach (var item in Model.Equipment.Items)
                    {
                        var displayedStatus = item.IsArchived ? "Archived" : item.ItemStatus;
                        if (displayedStatus == "UnderMaintenance") { displayedStatus = "Under maintenance"; }
                        var displayedCondition = item.ConditionStatus switch
                        {
                            "NeedsInspection" => "Needs inspection",
                            "UnderRepair" => "Under repair",
                            _ => item.ConditionStatus
                        };
                        var badgeClass = item.IsArchived ? "status-neutral" : item.ItemStatus switch
                        {
                            "Available" => "status-info",
                            "Borrowed" => "status-success",
                            "UnderMaintenance" => "status-warning",
                            _ => "status-neutral"
                        };
                        <tr>
                            <td><span class="item-code">@item.ItemCode</span></td>
                            <td>
                                <strong>@item.ItemName</strong>
                                @if (!string.IsNullOrWhiteSpace(item.Brand) || !string.IsNullOrWhiteSpace(item.Model))
                                {
                                    <span class="inventory-table-subtext">@item.Brand @item.Model</span>
                                }
                            </td>
                            <td>@item.CategoryName</td>
                            <td>@(string.IsNullOrWhiteSpace(item.SerialNumber) ? "—" : item.SerialNumber)</td>
                            <td><span class="status-badge rounded-full status-neutral">@displayedCondition</span></td>
                            <td>
                                <span class="status-badge rounded-full @badgeClass">@displayedStatus</span>
                                @if (item.IsLocked && !item.IsArchived)
                                {
                                    <span class="inventory-table-subtext">Active reservation or loan</span>
                                }
                            </td>
                            <td>@item.Location</td>
                            <td class="inventory-table-actions">
                                @if (!item.IsArchived && !item.IsLocked)
                                {
                                    <a asp-action="EditEquipment" asp-route-id="@item.EquipmentId">Edit</a>
                                }
                                else if (item.IsLocked && !item.IsArchived)
                                {
                                    <span title="Close the active reservation or loan before editing">Locked</span>
                                }
                                <form asp-action="SetEquipmentArchived" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.EquipmentId" />
                                    <input type="hidden" name="archived" value="@(!item.IsArchived).ToString().ToLowerInvariant()" />
                                    <input type="hidden" name="equipmentSearch" value="@Model.Equipment.Search" />
                                    <input type="hidden" name="equipmentStatus" value="@Model.Equipment.StatusFilter" />
                                    <input type="hidden" name="equipmentCategoryId" value="@Model.Equipment.CategoryId" />
                                    <input type="hidden" name="equipmentPage" value="@Model.Equipment.Page" />
                                    <button type="submit" onclick="return confirm('@(item.IsArchived ? "Restore this item to active inventory?" : "Archive this item from active inventory? Its reservation and return history will be preserved.")')">@(item.IsArchived ? "Restore" : "Archive")</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <partial name="Components/_Pagination" model="@(new PaginationViewModel
        {
            Page = Model.Equipment.Page, TotalPages = Model.Equipment.TotalPages, TotalCount = Model.Equipment.TotalCount,
            Label = "Equipment item pages", PageParameter = "equipmentPage",
            Routes = {
                ["tab"] = "equipment", ["equipmentSearch"] = Model.Equipment.Search,
                ["equipmentStatus"] = Model.Equipment.StatusFilter, ["equipmentCategoryId"] = Model.Equipment.CategoryId?.ToString(),
                ["categorySearch"] = Model.CategorySearch, ["categoryStatus"] = Model.CategoryStatusFilter,
                ["categoryPage"] = Model.CategoryPage.ToString()
            }
        })" />
    </section>
</div>

<div id="modal-create-category" class="management-modal fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4" role="dialog" aria-modal="true" aria-labelledby="modal-create-title">
    <div class="management-modal-card w-full max-w-lg bg-white p-6 shadow-2xl">
        <div class="mb-4 flex items-center justify-between border-b border-gray-200 pb-3">
            <h3 id="modal-create-title" class="font-display text-xl font-semibold text-ink">Create equipment category</h3>
            <button type="button" class="btn-close-modal text-gray-400 hover:text-ink text-lg font-bold" aria-label="Close modal">&times;</button>
        </div>
        <form asp-action="Create" method="post" id="form-create-category">
            @Html.AntiForgeryToken()
            <div class="space-y-4">
                <div><label for="create-category-code" class="mb-1 block text-sm font-medium text-gray-700">Category code <span class="required-marker" data-required-marker aria-hidden="true">*</span></label><input type="text" name="CategoryCode" id="create-category-code" required maxlength="50" placeholder="e.g. LAP" class="input uppercase" /></div>
                <div><label for="create-category-name" class="mb-1 block text-sm font-medium text-gray-700">Category name <span class="required-marker" data-required-marker aria-hidden="true">*</span></label><input type="text" name="CategoryName" id="create-category-name" required maxlength="150" placeholder="e.g. Laptops" class="input" /></div>
                <div><label for="create-category-description" class="mb-1 block text-sm font-medium text-gray-700">Description</label><textarea name="Description" id="create-category-description" rows="3" maxlength="1000" placeholder="Brief description of items in this category..." class="input"></textarea></div>
                <p class="rounded-xl bg-tint-soft px-4 py-3 text-sm text-primary-strong">New categories are active by default. Use the status action on the category card to deactivate one.</p>
            </div>
            <div class="form-actions"><button type="button" class="btn-close-modal btn-secondary">Cancel</button><button type="submit" class="btn-primary">Create category</button></div>
        </form>
    </div>
</div>

<div id="modal-edit-category" class="management-modal fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4" role="dialog" aria-modal="true" aria-labelledby="modal-edit-title">
    <div class="management-modal-card w-full max-w-lg bg-white p-6 shadow-2xl">
        <div class="mb-4 flex items-center justify-between border-b border-gray-200 pb-3">
            <h3 id="modal-edit-title" class="font-display text-xl font-semibold text-ink">Edit category</h3>
            <button type="button" class="btn-close-modal text-gray-400 hover:text-ink text-lg font-bold" aria-label="Close modal">&times;</button>
        </div>
        <form asp-action="Edit" method="post" id="form-edit-category">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CategoryId" id="edit-category-id" />
            <div class="space-y-4">
                <div><label for="edit-category-code" class="mb-1 block text-sm font-medium text-gray-700">Category code <span class="required-marker" data-required-marker aria-hidden="true">*</span></label><input type="text" name="CategoryCode" id="edit-category-code" required maxlength="50" class="input uppercase" /><p class="mt-1 text-xs text-gray-500">Changing category details does not change its active status.</p></div>
                <div><label for="edit-category-name" class="mb-1 block text-sm font-medium text-gray-700">Category name <span class="required-marker" data-required-marker aria-hidden="true">*</span></label><input type="text" name="CategoryName" id="edit-category-name" required maxlength="150" class="input" /></div>
                <div><label for="edit-category-description" class="mb-1 block text-sm font-medium text-gray-700">Description</label><textarea name="Description" id="edit-category-description" rows="3" maxlength="1000" class="input"></textarea></div>
            </div>
            <div class="form-actions"><button type="button" class="btn-close-modal btn-secondary">Cancel</button><button type="submit" class="btn-primary">Save changes</button></div>
        </form>
    </div>
</div>

<div id="modal-status-category" class="management-modal fixed inset-0 z-50 hidden items-center justify-center bg-black/60 p-4" role="dialog" aria-modal="true" aria-labelledby="modal-status-title">
    <div class="management-modal-card w-full max-w-md bg-white p-6 shadow-2xl">
        <div class="mb-4 flex items-center justify-between border-b border-gray-200 pb-3">
            <h3 id="modal-status-title" class="font-display text-xl font-semibold text-ink">Deactivate category</h3>
            <button type="button" class="btn-close-modal text-gray-400 hover:text-ink text-lg font-bold" aria-label="Close modal">&times;</button>
        </div>
        <form asp-action="SetActive" method="post" id="form-status-category">
            @Html.AntiForgeryToken()
            <input type="hidden" name="CategoryId" id="status-category-id" />
            <input type="hidden" name="IsActive" id="status-category-is-active" />
            <p id="modal-status-message" class="text-sm leading-6 text-gray-700"><span id="modal-status-action-text">Are you sure you want to deactivate</span> <strong id="status-category-name" class="font-semibold text-ink"></strong><span id="modal-status-question-mark">?</span></p>
            <p id="modal-status-hint" class="mt-2 text-xs leading-5 text-gray-500">Existing equipment and transaction history remain preserved. Inactive categories cannot be selected for new items.</p>
            <div class="form-actions"><button type="button" class="btn-close-modal btn-secondary">Cancel</button><button type="submit" id="btn-status-confirm" class="btn-primary">Confirm</button></div>
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/management-modals.js" asp-append-version="true"></script>
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const createModal = document.getElementById('modal-create-category');
            const editModal = document.getElementById('modal-edit-category');
            const statusModal = document.getElementById('modal-status-category');
            const openModal = modal => { if (modal) { modal.classList.remove('hidden'); modal.classList.add('flex'); } };
            const closeModal = modal => { if (modal) { modal.classList.add('hidden'); modal.classList.remove('flex'); } };
            const closeAll = () => [createModal, editModal, statusModal].forEach(closeModal);

            document.getElementById('btn-open-create-modal')?.addEventListener('click', () => openModal(createModal));
            document.querySelectorAll('.btn-open-edit').forEach(button => button.addEventListener('click', () => {
                document.getElementById('edit-category-id').value = button.dataset.id;
                document.getElementById('edit-category-code').value = button.dataset.code || '';
                document.getElementById('edit-category-name').value = button.dataset.name || '';
                document.getElementById('edit-category-description').value = button.dataset.description || '';
                openModal(editModal);
            }));
            document.querySelectorAll('.btn-open-status').forEach(button => button.addEventListener('click', () => {
                const active = button.dataset.active === 'true';
                document.getElementById('status-category-id').value = button.dataset.id;
                document.getElementById('status-category-is-active').value = (!active).toString();
                document.getElementById('status-category-name').textContent = button.dataset.name || 'this category';
                document.getElementById('modal-status-title').textContent = active ? 'Deactivate category' : 'Activate category';
                document.getElementById('modal-status-action-text').textContent = active ? 'Are you sure you want to deactivate' : 'Are you sure you want to activate';
                document.getElementById('btn-status-confirm').textContent = active ? 'Deactivate' : 'Activate';
                openModal(statusModal);
            }));
            document.querySelectorAll('.btn-close-modal').forEach(button => button.addEventListener('click', closeAll));
            [createModal, editModal, statusModal].forEach(modal => modal?.addEventListener('click', event => {
                if (event.target === modal) closeModal(modal);
            }));
            document.addEventListener('keydown', event => { if (event.key === 'Escape') closeAll(); });
        })();
    </script>
}
